{
  "name": "ai-test-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript UI test framework for Replyn",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --project=smoke",
    "test:regression": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --ui",
    "report": "playwright show-report",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:clinic": "playwright test tests/clinic",
    "test:doctors": "playwright test tests/clinic/doctors",
    "test:treatments": "playwright test tests/clinic/treatments",
    "test:departments": "playwright test tests/clinic/departments",
    "test:appointments": "playwright test tests/clinic/appointments",
    "test:billing": "playwright test tests/clinic/billing",
    "test:login": "playwright test tests/auth",
    "test:headless": "cross-env HEADLESS=true playwright test",
    "test:settings": "playwright test tests/settings",
    "test:members": "playwright test tests/settings/members",
    "test:roles": "playwright test tests/settings/roles tests/settings/workspace-users",
    "test:contact-fields": "playwright test tests/settings/contact-fields",
    "test:outcome-reasons": "playwright test tests/settings/outcome-reasons",
    "test:wrap-up": "playwright test --project=workspace-settings",
    "test:api-keys": "playwright test tests/settings/api-keys tests/settings/webhooks",
    "test:inbox": "playwright test tests/inbox",
    "test:exclusive": "cross-env EXCLUSIVE_TESTS=true playwright test --project=exclusive",
    "test:organization": "cross-env EXCLUSIVE_TESTS=true playwright test --project=exclusive tests/settings/organization",
    "test:workspace": "cross-env EXCLUSIVE_TESTS=true playwright test --project=exclusive tests/settings/workspace tests/settings/hours tests/settings/sla tests/settings/assignment tests/settings/ai",
    "test:lifecycle": "cross-env EXCLUSIVE_TESTS=true playwright test --project=exclusive tests/settings/lifecycle",
    "test:contacts": "playwright test tests/contacts",
    "test:all": "node scripts/test-all.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.7"
  }
}
